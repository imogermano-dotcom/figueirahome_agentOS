[
    {
        "name": "sync-imoveis-manha",
        "app_name": "figueirahome-crons",
        "schedule": "17 6 * * *",
        "region": "ams",
        "command": "sh -c \"curl -sf -X POST https://figueirahome-agentos.fly.dev/api/imoveis/sync/egorealestate/api -H \\\"X-Sync-Secret: $EGOREALESTATE_SYNC_SECRET\\\" -w '\\ntempo total: %{time_total}s\\n' --max-time 600\"",
        "command_timeout": 650,
        "enabled": true,
        "config": {
            "metadata": { "fly_process_group": "cron" },
            "auto_destroy": true,
            "disable_machine_autostart": true,
            "guest": { "cpu_kind": "shared", "cpus": 1, "memory_mb": 256 },
            "image": "docker-hub-mirror.fly.io/curlimages/curl:latest",
            "restart": { "max_retries": 1, "policy": "no" }
        }
    },
