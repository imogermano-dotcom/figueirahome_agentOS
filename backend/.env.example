# Anthropic
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Telnyx
TELNYX_API_KEY=YOUR_TELNYX_API_KEY
TELNYX_PUBLIC_KEY=YOUR_TELNYX_WEBHOOK_PUBLIC_KEY
TELNYX_PHONE_NUMBER=YOUR_TELNYX_PHONE_NUMBER

# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI (Whisper STT)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Meta WhatsApp Business
META_WHATSAPP_TOKEN=YOUR_WHATSAPP_GRAPH_API_TOKEN
META_APP_SECRET=YOUR_META_APP_SECRET
META_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
META_VERIFY_TOKEN=YOUR_CHOSEN_VERIFY_TOKEN
META_API_VERSION=v19.0

# App
APP_BASE_URL=https://your-backend.fly.dev
ENVIRONMENT=development

# Notificacoes ao corretor (lead qualificada, escalamento) via Microsoft Graph
# Vazio = desligadas, sem erro. Entra ID: registo de aplicacao com permissao de
# APLICACAO Mail.Send e consentimento de administrador.
GRAPH_TENANT_ID=YOUR_TENANT_ID
GRAPH_CLIENT_ID=YOUR_CLIENT_ID
GRAPH_CLIENT_SECRET=YOUR_CLIENT_SECRET
GRAPH_REMETENTE=avisos@exemplo.pt
NOTIFICACOES_PARA=corretor@exemplo.pt
